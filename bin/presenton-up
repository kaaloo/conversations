#!/usr/bin/env bash
#
# One-shot local stand-up for the slides-loop POC (docs/presenton-sidecar.md).
#
# Brings up the whole stack the deck card needs and waits until it is usable:
#
#   postgresql, redis, objectstorage, mailcatcher, keycloak (+ their DB)
#   app-dev, nginx, celery-dev, frontend-development   -> UI on :3000
#   presenton (sidecar)                                -> editor on :5001
#
# It is idempotent: re-running rebuilds nothing that is already built, keeps
# ./data (database, objectstorage, presenton decks) and only re-applies env.
#
# Usage:
#   bin/presenton-up              # start everything, wait for health
#   bin/presenton-up --no-build   # skip the backend/frontend image builds
#   bin/presenton-up --reset      # wipe ./data first (drops all local state)
#
# Requirements on the host: docker (Colima is fine) with >= 6 CPU / 8 GiB
# available to the VM; ALBERT_API_KEY in the environment the first time it
# writes the env files.
#
# Security: the sidecar runs with DISABLE_AUTH=true, published on 127.0.0.1
# only. Never expose port 5001 beyond loopback.

set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "${REPO_DIR}"

COMPOSE_FILES=( -f compose.yml -f compose.presenton.yml )
DOCKER_USER_ID="$(id -u):$(id -g)"
COMPOSE=( docker compose "${COMPOSE_FILES[@]}" )

BUILD=1
RESET=0
for arg in "$@"; do
    case "${arg}" in
        --no-build) BUILD=0 ;;
        --reset)    RESET=1 ;;
        -h|--help)  sed -n '2,29p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "unknown option: ${arg} (try --help)" >&2; exit 2 ;;
    esac
done

step() { printf '\n\033[1m==> %s\033[0m\n' "$*"; }
warn() { printf '\033[1;33m[warn]\033[0m %s\n' "$*" >&2; }
die()  { printf '\033[1;31m[error]\033[0m %s\n' "$*" >&2; exit 1; }

# --- 0. Preconditions -------------------------------------------------------

step "Checking Docker"
command -v docker >/dev/null || die "docker not found on PATH"
docker info >/dev/null 2>&1 || die "Docker daemon is not reachable. Start Colima (colima start) or Docker Desktop."

read -r cpus mem_bytes < <(docker info --format '{{.NCPU}} {{.MemTotal}}')
mem_gib=$(( mem_bytes / 1024 / 1024 / 1024 ))
echo "docker VM: ${cpus} CPU, ${mem_gib} GiB RAM"
if [ "${mem_gib}" -lt 8 ] || [ "${cpus}" -lt 4 ]; then
    warn "the VM is undersized for Conversations + Presenton (Chromium, ~3.7 GB image)."
    warn "resize it once with: colima stop && colima start --cpu 6 --memory 10"
fi

# The frontend image runs `yarn install` on node:24-alpine. With Containers's
# built-in forwarder as the only nameserver, musl's resolver intermittently
# returns EAI_AGAIN under yarn's parallel lookups, which fails the build with a
# misleading network error. Public resolvers on the daemon fix it; detect the
# symptom rather than assuming the setting, and warn loudly.
if docker run --rm node:24-alpine node -e '
    const dns=require("dns");let f=0,d=0;const N=8;
    for(let i=0;i<N;i++)dns.lookup("registry.yarnpkg.com",{all:true},(e)=>{e?f++:d++;if(d+f===N){process.exit(f?1:0)}});
  ' >/dev/null 2>&1; then
    :
else
    warn "container DNS lookups are unreliable: the frontend build will fail on 'yarn install' (EAI_AGAIN)."
    warn "fix once with: colima ssh -- sudo sh -c 'cat > /etc/docker/daemon.json <<EOF ... \"dns\": [\"1.1.1.1\", \"8.8.8.8\"] ... EOF; systemctl restart docker'"
    warn "or add \"dns\": [\"1.1.1.1\", \"8.8.8.8\"] to /etc/docker/daemon.json inside the Colima VM and restart docker."
fi

# --- 1. Env files -----------------------------------------------------------

step "Preparing env files"
created_env=0
for pair in common:common.dist postgresql:postgresql.dist kc_postgresql:kc_postgresql.dist; do
    target="env.d/development/${pair%%:*}"
    source="env.d/development/${pair##*:}"
    if [ ! -f "${target}" ]; then
        cp "${source}" "${target}"
        created_env=1
        echo "created ${target}"
    fi
done

if [ ! -f env.d/development/presenton ]; then
    [ -n "${ALBERT_API_KEY:-}" ] || die "ALBERT_API_KEY is not set: needed to write env.d/development/presenton"
    PRESENTON_LLM_API_KEY="${ALBERT_API_KEY}" \
        sed -e 's|^PRESENTON_LLM_BASE_URL=.*|PRESENTON_LLM_BASE_URL=https://albert.api.etalab.gouv.fr/v1|' \
            -e 's|^PRESENTON_LLM_MODEL=.*|PRESENTON_LLM_MODEL=mistral-medium-3-5|' \
            -e "s|^PRESENTON_LLM_API_KEY=.*|PRESENTON_LLM_API_KEY=${ALBERT_API_KEY}|" \
            env.d/development/presenton.dist > env.d/development/presenton
    echo "created env.d/development/presenton (Albert API)"
    created_env=1
fi

if ! grep -q '^AI_BASE_URL=' env.d/development/common; then
    [ -n "${ALBERT_API_KEY:-}" ] || die "ALBERT_API_KEY is not set: needed to configure AI_BASE_URL in env.d/development/common"
    {
        echo ""
        echo "# AI (Albert API) - added by bin/presenton-up"
        echo "AI_BASE_URL=https://albert.api.etalab.gouv.fr/v1"
        echo "AI_MODEL=mistral-medium-3-5"
        echo "AI_API_KEY=${ALBERT_API_KEY}"
    } >> env.d/development/common
    echo "configured AI_* in env.d/development/common (Albert API)"
    created_env=1
fi

if [ "${created_env}" -eq 0 ]; then
    echo "env files already present, left untouched"
fi

# The overlay needs these values in the shell environment for interpolation.
set -a
# shellcheck disable=SC1091
. env.d/development/presenton
set +a

if [ "${RESET}" -eq 1 ]; then
    step "Resetting local state"
    "${COMPOSE[@]}" down --volumes --remove-orphans
    rm -rf data/presenton
    echo "removed containers and data/presenton"
fi

# --- 2. Images --------------------------------------------------------------

if [ "${BUILD}" -eq 1 ]; then
    step "Building backend and frontend images (skipped if up to date)"
    DOCKER_USER="${DOCKER_USER_ID}" "${COMPOSE[@]}" build app-dev frontend-development
else
    echo "skipping image build (--no-build)"
fi

step "Fetching the Presenton sidecar image (~3.7 GB on first run)"
"${COMPOSE[@]}" pull presenton

# --- 3. Data dirs -----------------------------------------------------------

mkdir -p data/static data/objectstorage data/presenton

# --- 4. Start the stack -----------------------------------------------------

step "Starting services"
# Bring up dependencies first so migrations are not racing the DB.
DOCKER_USER="${DOCKER_USER_ID}" "${COMPOSE[@]}" up -d postgresql kc_postgresql redis mailcatcher objectstorage
echo "waiting for postgres..."
for _ in $(seq 1 60); do
    "${COMPOSE[@]}" exec -T postgresql pg_isready -d conversations -U dinum >/dev/null 2>&1 && break
    sleep 1
done

step "Running migrations"
"${COMPOSE[@]}" run --rm --user="${DOCKER_USER_ID}" app-dev python manage.py migrate --noinput

step "Creating the POC superuser"
"${COMPOSE[@]}" run --rm --user="${DOCKER_USER_ID}" app-dev \
    python manage.py createsuperuser --email admin@example.com --password admin || \
    warn "superuser step reported an error; the OIDC login may already provide access"

step "Starting the application, sidecar and frontend"
DOCKER_USER="${DOCKER_USER_ID}" "${COMPOSE[@]}" up -d --force-recreate app-dev nginx celery-dev frontend-development presenton

# --- 5. Wait for readiness --------------------------------------------------

wait_for() {
    local label="$1" url="$2" attempts="$3"
    printf 'waiting for %s at %s' "${label}" "${url}"
    for _ in $(seq 1 "${attempts}"); do
        if curl -fsS -o /dev/null --max-time 3 "${url}" 2>/dev/null; then
            printf ' ok\n'
            return 0
        fi
        printf '.'
        sleep 2
    done
    printf ' TIMEOUT\n'
    return 1
}

step "Waiting for services"
sidecar_ok=0
backend_ok=0
frontend_ok=0
wait_for "Presenton sidecar" "http://localhost:${PRESENTON_HOST_PORT:-5001}/" 90 && sidecar_ok=1
wait_for "backend (via nginx)" "http://localhost:8071/api/v1.0/" 60 && backend_ok=1
wait_for "frontend" "http://localhost:3000/" 90 && frontend_ok=1

# --- 5b. Re-apply the LLM provider inside Presenton ---------------------------
#
# Presenton imports LLM settings from the environment once, on its first boot,
# into its own SQLite `provider_settings` row, and that row WINS over the env
# afterwards. Changing env.d/development/presenton (or fixing a bad key) has no
# effect on an existing ./data/presenton: generation then fails with
# "401 Invalid API key" even though the environment is correct.
# With DISABLE_AUTH=true the admin settings route needs no credentials, so we
# push the environment values in explicitly on every run.
if [ "${sidecar_ok}" -eq 1 ]; then
    step "Syncing the LLM provider into Presenton"
    if PRESENTON_LLM_BASE_URL="${PRESENTON_LLM_BASE_URL}" \
       PRESENTON_LLM_MODEL="${PRESENTON_LLM_MODEL}" \
       PRESENTON_LLM_API_KEY="${PRESENTON_LLM_API_KEY}" \
       PRESENTON_URL="http://localhost:${PRESENTON_HOST_PORT:-5001}" \
       python3 - <<'PY'
import json, os, urllib.request

body = json.dumps({
    "LLM": "custom",
    "CUSTOM_LLM_URL": os.environ["PRESENTON_LLM_BASE_URL"],
    "CUSTOM_LLM_API_KEY": os.environ["PRESENTON_LLM_API_KEY"],
    "CUSTOM_MODEL": os.environ["PRESENTON_LLM_MODEL"],
}).encode()
req = urllib.request.Request(
    os.environ["PRESENTON_URL"].rstrip("/") + "/api/v1/admin/provider-settings",
    data=body, method="PUT", headers={"Content-Type": "application/json"},
)
with urllib.request.urlopen(req, timeout=30) as resp:
    saved = json.loads(resp.read())
expected = os.environ["PRESENTON_LLM_API_KEY"]
if saved.get("CUSTOM_LLM_API_KEY") != expected:
    raise SystemExit("provider settings did not persist the configured API key")
print("provider ok: %s / %s" % (saved.get("CUSTOM_LLM_URL"), saved.get("CUSTOM_MODEL")))
PY
    then
        :
    else
        warn "could not push LLM provider settings into Presenton; deck generation will fail with 401."
        warn "check that $PRESENTON_LLM_API_KEY is the right key for $PRESENTON_LLM_BASE_URL."
    fi
fi

# --- 6. Summary -------------------------------------------------------------

cat <<EOF

$(printf '\033[1mPOC stack\033[0m')

  App (login as conversations / conversations)
    http://localhost:3000

  Presenton editor (single-user POC mode, loopback only)
    http://localhost:5001

  Django admin (admin@example.com / admin)
    http://localhost:8071/admin

  Sidecar health / API
    http://localhost:5001/api/v1/ppt/presentation/status

$(printf '\033[1mTry it\033[0m'): open the app, start a conversation and ask for a deck,
e.g. "Create a 4-slide deck introducing la Suite numerique for civil servants".
The chat should call generate_presentation_sidecar and render a deck card with
Open editor / Download PPTX.

$(printf '\033[1mIntegrity check (no LLM)\033[0m')
    PRESENTON_URL=http://localhost:5001 python3 bin/presenton-spike

$(printf '\033[1mLogs / teardown\033[0m')
    docker compose $(printf '%s ' "${COMPOSE_FILES[@]}")logs -f app-dev presenton
    bin/presenton-down          # stop, keep data
    bin/presenton-down --wipe   # stop and delete ./data
EOF

if [ "${sidecar_ok}" -eq 0 ] || [ "${backend_ok}" -eq 0 ] || [ "${frontend_ok}" -eq 0 ]; then
    warn "one or more services did not answer in time; check: docker compose ${COMPOSE_FILES[*]} ps"
    exit 1
fi
